{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr-frontmatter.schema.json",
  "title": "ADR Frontmatter",
  "type": "object",
  "required": ["adr", "title", "status", "date", "deciders"],
  "properties": {
    "adr": { "type": "string" },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "active",
        "superseded",
        "deprecated",
        "rejected",
        "archived"
      ]
    },
    "date": { "type": "string" },
    "deciders": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supersededBy": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
